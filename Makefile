# ==============================================================================
# Gateway E2E (g2g_bdd against real DIDComm mediators)
# ==============================================================================
G2G_MEDIATOR_PORT ?= 7037

gw-e2e: clean-e2e ## Run the gateway-to-gateway BDD E2E suite (federation)
	@echo "$(BLUE)🧪 Running g2g_bdd...$(NC)"
	@parallelism="$${G2G_BDD_PARALLELISM:-8}"; \
	if [ "$$parallelism" = "1" ]; then \
		G2G_BDD_PARALLELISM="$$parallelism" \
		FABRIC_BDD_MANAGED_MEDIATOR="1" \
		FABRIC_BDD_MEDIATOR_PORT="$(G2G_MEDIATOR_PORT)" \
		FABRIC_BDD_DID_METHOD="peer" \
		RUST_LOG="$(if $(RUST_LOG),$(RUST_LOG),info)" \
			cargo test --test g2g_bdd $(CARGO_TEST_ARGS); \
	else \
		G2G_BDD_PARALLELISM="$$parallelism" \
		FABRIC_BDD_MANAGED_MEDIATOR="1" \
		FABRIC_BDD_DID_METHOD="peer" \
		RUST_LOG="$(if $(RUST_LOG),$(RUST_LOG),info)" \
			cargo test --test g2g_bdd $(CARGO_TEST_ARGS); \
	fi

# Prune any leftover BDD mediator containers + networks + temp dirs from a
# prior run that panicked before its Drop could tear the mediator down. Runs
# as a `gw-e2e` pre-step so a normal `make gw-e2e` is self-healing.
clean-e2e: ## Remove leftover g2g_bdd mediator containers + networks + temp dirs
	@echo "$(BLUE)🧹 Cleaning up leftover BDD containers...$(NC)"
	@docker ps -aq --filter "name=g2g-bdd-mediator" 2>/dev/null \
		| xargs -r docker rm -f >/dev/null 2>&1 || true
	@docker network ls -q --filter "name=g2g-bdd-mediator" 2>/dev/null \
		| xargs -r docker network rm >/dev/null 2>&1 || true
	@rm -rf tmp/g2g-* 2>/dev/null || true
	@echo "$(GREEN)✅ BDD test containers cleaned!$(NC)"

# Needs Node >= 20.18.1, git and openssl; the first run fetches the pinned suite
# and reference server. ARGS passes options through, e.g. ARGS="--unit-tests" or
# ARGS="--only access-point,legacy". See scripts/mcp-conformance/README.md.
mcp-conformance: ## Run the MCP 2026-07-28 conformance harness (ARGS="--unit-tests" etc.)
	@./scripts/mcp-conformance/run.sh $(ARGS)

mcp-conformance-legacy: ## Run only the MCP legacy (2024-11-05) compatibility checks
	@./scripts/mcp-conformance/run.sh --only legacy $(ARGS)

