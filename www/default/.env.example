# Example env file for the React management dashboard.
# Copy to `.env.development` (for `npm start`) or `.env.production` (for `npm run build`)
# and adjust values. CRA exposes only variables prefixed with REACT_APP_.
#
# WebSocket endpoint the dashboard connects to.
REACT_APP_WS_URL=ws://localhost:8080/api/ws

# --- Feature flags ---
# See www/default/src/utils/featureFlags.ts for the consuming code.
# Set to "true" to enable; any other value (including unset) keeps it disabled.

# Show the MPP Paywall section in the channel Policies tab.
REACT_APP_ENABLE_MPP_PAYWALL=false
