# Production env for the React management dashboard build (`npm run build`).
# Variables here are baked into the static bundle. Do NOT put secrets here.
#
# REACT_APP_WS_URL is intentionally unset: AppContext falls back to
# `${ws|wss}://${window.location.host}/api/ws`, which is what we want when the
# dashboard is served from the same host as the gateway.

# --- Feature flags ---
REACT_APP_ENABLE_MPP_PAYWALL=false
