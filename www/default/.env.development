# REACT_APP_WS_URL intentionally unset: falls back to
# ${ws|wss}://${window.location.host}/api/ws, which CRA's dev proxy
# routes to the backend. This works for all instances.
REACT_APP_ENABLE_MPP_PAYWALL=false
GENERATE_SOURCEMAP=false
# When accessed through a tunnel the page origin port differs from the
# webpack-dev-server port (3002). WDS_SOCKET_PORT=0 tells the HMR client
# to use window.location.port (the tunnel port) for its websocket reconnect
# instead of hardcoding the dev-server port.
WDS_SOCKET_PORT=0
