  "payment_schemes": [
    {
      "id": "exact",
      "name": "Exact Amount",
      "description": "Payment must match exact amount"
    },
    {
      "id": "upto",
      "name": "At Least",
      "description": "Payment must be at least the specified amount"
    }
  ],
  "verification_modes": [
    {
      "id": "mock",
      "name": "Level 0 - No verification (For testing only)",
      "description": "Accepts any payment without verification - for testing only"
    },
    {
      "id": "signature",
      "name": "Level 1 - Verify cryptographic signature",
      "description": "Verifies EIP-3009 or Permit2 signatures cryptographically but does not check on-chain state (suitable for low-value payments or when on-chain verification is not possible)"
    },
    {
      "id": "local",
      "name": "Level 2 - Gateway verifies on-chain",
      "description": "Verifies payment directly on blockchain via RPC from Gateway"
    },
    {
      "id": "fabric_gateway",
      "name": "Level 3 - Facilitator via Fabric Gateway",
      "description": "Delegates payment verification to another connected gateway via DIDComm messages"
    },
    {
      "id": "external_facilitator",
      "name": "Level 4 - Facilitator via external provider",
      "description": "Uses external HTTP payment verification service (x402 v2 spec)"
    }
  ],
  "settlement_modes": [
    {
      "id": "none",
      "name": "None",
      "description": "No settlement action - verification only"
    },
    {
      "id": "deferred",
      "name": "Deferred",
      "description": "Records payment for batch settlement later. Settlement location depends on verification mode: Local (this gateway), Fabric Gateway (both gateways with signaling), or External Facilitator (external service)"
    },
    {
      "id": "immediate",
      "name": "Immediate",
      "description": "Executes settlement immediately after verification. Settlement method depends on verification mode: Local (embedded facilitator executes on-chain), Fabric Gateway (delegates to other gateway), or External Facilitator (delegates to external service)"
    }
  ],
