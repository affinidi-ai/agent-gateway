  "client_secret_secret_ref": "GITHUB_CLIENT_SECRET",
  "default_scopes": [
    "repo"
  ],
  "callback_path": "/v1/identity/oauth/callback/github",
  "callback_url": "https://gw.example.com/v1/identity/oauth/callback/github",
  "token_refresh_enabled": true,
  "additional_params": {
    "prompt": "consent"
  },
  "description": "GitHub OAuth",
