{
  "name": "agent-gateway-ui-tests",
  "version": "1.0.0",
  "description": "Automated UI tests for Agent Gateway Dashboard",
  "private": true,
  "scripts": {
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:report": "playwright show-report test_results/latest/html",
    "test:ui:codegen": "playwright codegen http://localhost:8080/dashboard",
    "pretest:ui": "mkdir -p test_results/.auth"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
